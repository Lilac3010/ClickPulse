# =====================================================================
# ClickPulse - SINGLE SOURCE OF TRUTH for every VM.
# Plain KEY=VALUE only (no "export", no $VAR expansion) so that both
# bash (via /etc/profile.d/clickpulse.sh) and systemd (EnvironmentFile=)
# can read it. Edit ONLY in git, then run scripts/install_configs.sh on all VMs.
# =====================================================================

# ---- Private IPs of the 4 VMs (EDIT THESE ONCE, commit, pull everywhere) ----
VM1_IP=10.0.0.11
VM2_IP=10.0.0.12
VM3_IP=10.0.0.13
VM4_IP=10.0.0.14
CLUSTER_SUBNET=10.0.0.0/24

# ---- Install locations (identical on every VM) ----
CP_HOME=/opt/clickpulse
JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
KAFKA_HOME=/opt/kafka
HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
SPARK_HOME=/opt/spark
DRUID_HOME=/opt/druid
CP_VENV=/opt/clickpulse/.venv

# ---- Kafka: ONE cluster, two brokers, both on VM1 ----
KAFKA_BOOTSTRAP=vm1:9092,vm1:9094
KAFKA_TOPIC=clickpulse.raw

# ---- HDFS: NameNode + DataNode on VM2 ----
HDFS_URI=hdfs://vm2:9000
HDFS_BASE=/clickpulse

# ---- Spark standalone on VM3 + Iceberg (Hadoop catalog on HDFS) ----
SPARK_MASTER_URL=spark://vm3:7077
ICEBERG_JAR=/opt/clickpulse/jars/iceberg-spark-runtime-3.5_2.12-1.6.1.jar
ICEBERG_WAREHOUSE=hdfs://vm2:9000/clickpulse/warehouse
ICEBERG_DB=lake.clickpulse

# ---- Druid + dashboard on VM4 ----
DRUID_ROUTER=http://vm4:8888
DRUID_DATASOURCE=clickpulse_events

# ---- Dataset (cloned on VM1 only) ----
DATA_DIR=/opt/clickpulse-data/ClickPulse

PYSPARK_PYTHON=python3
TZ=UTC
